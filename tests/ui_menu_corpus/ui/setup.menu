#include "ui/menudef.h"
#include "ui/corpus.h"
#include "ui/corpus.h"		/* included twice: the guard keeps one copy */

{
/* Issue #11 corpus: macros, conditionals, signed and hex numbers,
   list and slider data, as the retail setup and options menus use. */
	menuDef {
		name "setup_menu"
		visible MENU_FALSE
		fullscreen MENU_FALSE
		rect SETUP_X 40 SETUP_W 400
		focusColor 1 .75 0 1
		outOfBoundsClick
		style WINDOW_STYLE_FILLED
		border WINDOW_BORDER_FULL
		borderSize 1.0
		borderColor .5 .5 .5 1
		backcolor 0 0 0 .5
		popup
		onESC { close setup_menu ; open main }

		itemDef {
			BUTTON(sensitivity, 60)
			type ITEM_TYPE_SLIDER
			text "Mouse Sensitivity:"
			cvarfloat "sensitivity" 5 -1 30.5
			textalign ITEM_ALIGN_RIGHT
			textalignx -12
			textaligny 17
			textscale .25
			forecolor 1 1 1 1
			visible 1
		}

		itemDef {
			BUTTON(quality, 90)
			type ITEM_TYPE_MULTI
			text "Quality:"
			cvar "r_quality"
			cvarFloatList { "High Quality" 1 "Normal" 0 "Fast" -1 "Fastest" -2.5 }
			textalignx 0x40
			visible 1
		}

		itemDef {
			BUTTON(team, 120)
			type ITEM_TYPE_MULTI
			text "Team:"
			cvar "ui_teamName"
			cvarStrList { "Pagans", "pagans", "Stroggs", "stroggs" }
			visible 1
		}

		itemDef {
			name demolist
			rect SETUP_X 150 SETUP_W 200
			type ITEM_TYPE_LISTBOX
			style WINDOW_STYLE_FILLED
			elementwidth 120
			elementheight 20
			feeder FEEDER_DEMOS
			elementtype LISTBOX_TEXT
			columns 2 2 40 20 -42 8 25
			backcolor 0 0 0 1
#ifdef MISSIONPACK
			forecolor 1 .75 0 1
#else
			forecolor 1 0 0 1
#endif
#if SETUP_X * 2 + SETUP_W == 640 && ITEM_TYPE_LISTBOX == 6
			border WINDOW_BORDER_HORZ
#else
			border WINDOW_BORDER_VERT
#endif
			visible 1
			doubleclick { uiScript LoadDemos }
		}
	}
}
